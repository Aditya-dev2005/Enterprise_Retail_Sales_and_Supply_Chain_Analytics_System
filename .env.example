# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub - add it to .gitignore.

# --- Database ---
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=Retail_Sales_and_Supply_Chain_Analytics_System

# --- AI Query Endpoint (OpenRouter) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Authentication (JWT) ---
# Generate a long random string for this, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRY_MINUTES=60
